{
  "profile": "claude-default-deepseek",
  "agent_kind": "claude-code",
  "adapter_kind": "claude-cli",
  "executable": "C:\\Users\\shiju\\AppData\\Roaming\\npm\\claude.cmd",
  "version": "2.1.214",
  "provider": "custom-anthropic-compatible",
  "auth_mode": "ApiKeyEnv",
  "roles": {
    "planner": {
      "profile": "claude-default-deepseek",
      "timeout": "adaptive",
      "permissions": "plan-only, no direct writes, no commit creation",
      "session_policy": "fresh per pilot"
    },
    "executor": {
      "profile": "claude-default-deepseek",
      "timeout": "adaptive",
      "permissions": "worktree-scoped writes only, no push",
      "session_policy": "fresh per pilot"
    },
    "reviewer": {
      "profile": "claude-default-deepseek",
      "timeout": "adaptive",
      "permissions": "read-only, no filesystem writes, no git writes, output: ReviewDecision",
      "session_policy": "fresh per pilot"
    },
    "evaluator": {
      "profile": "claude-default-deepseek",
      "timeout": "adaptive",
      "permissions": "read-only, no filesystem writes, no git writes, output: Assessment",
      "session_policy": "fresh per pilot"
    }
  },
  "secrets": {
    "api_key": "present (env var, source: ANTHROPIC_API_KEY, redacted)",
    "credential_ref": "absent"
  },
  "session_isolation": {
    "cross_role_resume": 0,
    "cross_pilot_resume": 0,
    "historical_session_reuse": 0,
    "fresh_sessions_per_role": true
  }
}
