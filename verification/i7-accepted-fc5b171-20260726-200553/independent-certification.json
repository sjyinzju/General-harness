{
  "certification_type": "Independent read-only certification",
  "session_properties": {
    "role": "Certification",
    "profile": "claude-default-deepseek",
    "session_mode": "fresh",
    "read_only": true,
    "resume_requested": false,
    "permission": "read-only — can only read frozen evidence files",
    "invocation_id": "inv-cert-{uuid} — unique",
    "harness_session_id": "hs-cert-{uuid} — unique, never resumed"
  },
  "evidence_access": {
    "allowed": ["code-head.txt", "summary.json", "*.json evidence files", "database snapshot"],
    "forbidden": ["code modification", "database writes", "E2E rerun", "evidence rewriting"]
  },
  "output": "independent-certification.json with verdict, blocking_findings, contradiction_count",
  "function": "run_independent_certification() in bootstrap.rs",
  "result_type": "CertificationResult { read_only: true, fresh_session_verified: true, evidence_frozen: true }"
}
